# Copy this file to .env and adjust values.
APP_NAME=News Detection Platform
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=backend/data/verilens.sqlite3
# Optional: create an API key in Google Cloud and enable Fact Check Tools API.
GOOGLE_FACTCHECK_API_KEY=AIzaSyAhScqR7Iflaqo7yq3m8PSKJR1NK-GTpPQ
# Set a long, private value before using the review API beyond local testing.
REVIEWER_TOKEN=change-this-to-a-long-random-secret
# DistilBERT model directory saved from Colab. Relative paths are relative to project root.
MODEL_DIR=backend/models/research_distilbert_random
# If no transformer model is available, API uses this trained TF-IDF baseline if present.
BASELINE_MODEL_PATH=backend/models/tfidf_random.joblib
MAX_LENGTH=256
ABSTAIN_THRESHOLD=0.65
